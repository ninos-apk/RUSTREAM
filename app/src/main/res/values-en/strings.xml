<resources>
    <string name="app_description">RUSTREAM IPTV PLAYER is an IPTV player built around a core written in Rust. It focuses on high performance and smooth streaming – especially for live sports and football.</string>
    <string name="app_info">App info</string>
    <string name="app_version">Version %1$s</string>
    <string name="about_title">About Rustream IPTV Player</string>
    <string name="about_version">Version: %1$s</string>
    <string name="about_developer">Developed by: Ninos Oshana</string>
    <string name="about_intro">Rustream IPTV Player is built from the ground up with one goal in mind: <b>performance, stability, and a smooth streaming experience.</b></string>
    <string name="about_technology">Powered by a Rust core and modern Kotlin streaming technologies, Rustream is designed to handle connection issues intelligently, recover automatically, rebuild interrupted connections, and optimize buffering for reliable playback.</string>
    <string name="about_independent">Rustream is developed independently, from scratch, by a single developer with a strong focus on efficiency, reliability, and performance.</string>
    <string name="about_support_title">Enjoying Rustream? Support the developer!</string>
    <string name="about_support_body">If you appreciate the stability, performance, and work behind Rustream, consider supporting its continued development through PayPal:</string>
    <string name="about_contribution">Every contribution is greatly appreciated and helps support the time and effort behind this project.</string>
    <string name="about_contact">Have a question, feedback, or want to report an issue? Feel free to send an email. Your feedback is always welcome.</string>
    <string name="about_thanks">Thank you for using Rustream IPTV Player!</string>
    <string name="about_email_unavailable">No email app is installed on this TV. You can copy the address and use it on another device.</string>

